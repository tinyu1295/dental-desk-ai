POSTGRES_USER=dental
POSTGRES_PASSWORD=dental
POSTGRES_DB=dental
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

TWILIO_AUTH_TOKEN=your_auth_token_here
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev
MEDIA_STREAM_URL=wss://your-subdomain.ngrok-free.dev/media-stream

# Required by BedrockStreamManager to authenticate to AWS Bedrock for Nova
# Sonic. docker-compose.yml passes these through to the voice_gateway
# container -- it does not inherit your host shell's exported env vars.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# Only needed for temporary/SSO/assumed-role credentials -- leave blank for
# a long-lived IAM user access key.
AWS_SESSION_TOKEN=
