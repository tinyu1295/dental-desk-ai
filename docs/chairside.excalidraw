      "boundElements": [],
      "updated": 1787682032099,
      "link": null,
      "locked": false,
      "text": "dental-desk-ai/\n├── docker-compose.yml          # infrastructure: Postgres + booking_service (+ voice_gateway)\n├── Makefile                    # manual smoke tests + health checks against the running API\n├── .env                        # local secrets/config, git-ignored\n├── .env.example                # template for required env vars\n└── services/\n    ├── booking_service/        # microservice\n    │   ├── Dockerfile\n    │   ├── requirements.txt\n    │   ├── TESTING.md          # manual smoke test docs (run via the root Makefile)\n    │   ├── TOOL_REFERENCE.md   # reference docs for booking tools/endpoints\n    │   └── app/\n    │       ├── main.py\n    │       └── db.py           # database connection/session setup\n    └── voice_gateway/          # microservice: telephony/voice streaming gateway\n        ├── Dockerfile\n        ├── requirements.txt\n        ├── TESTING.md          # manual smoke test docs\n        ├── test_bedrock_stream.py\n        ├── test_media_stream.py\n        ├── test_signature.py\n        ├── my_recording.wav    # sample/local test audio (should likely be git-ignored)\n        └── app/\n            ├── main.py\n            ├── audio.py         # audio encoding/decoding helpers\n            └── bedrock_stream.py # streaming integration with Amazon Bedrock\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dental-desk-ai/\n├── docker-compose.yml          # infrastructure: Postgres + booking_service (+ voice_gateway)\n├── Makefile                    # manual smoke tests + health checks against the running API\n├── .env                        # local secrets/config, git-ignored\n├── .env.example                # template for required env vars\n└── services/\n    ├── booking_service/        # microservice\n    │   ├── Dockerfile\n    │   ├── requirements.txt\n    │   ├── TESTING.md          # manual smoke test docs (run via the root Makefile)\n    │   ├── TOOL_REFERENCE.md   # reference docs for booking tools/endpoints\n    │   └── app/\n    │       ├── main.py\n    │       └── db.py           # database connection/session setup\n    └── voice_gateway/          # microservice: telephony/voice streaming gateway\n        ├── Dockerfile\n        ├── requirements.txt\n        ├── TESTING.md          # manual smoke test docs\n        ├── test_bedrock_stream.py\n        ├── test_media_stream.py\n        ├── test_signature.py\n        ├── my_recording.wav    # sample/local test audio (should likely be git-ignored)\n        └── app/\n            ├── main.py\n            ├── audio.py         # audio encoding/decoding helpers\n            └── bedrock_stream.py # streaming integration with Amazon Bedrock\n",
