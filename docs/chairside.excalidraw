    {
      "id": "hwlwj_iJjNpNyD69VnP32",
      "type": "text",
      "x": 27827.656678567164,
      "y": -7621.543662884415,
      "width": 863.7260783634985,
      "height": 280.4305449232138,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF2",
      "roundness": null,
      "seed": 800097241,
      "version": 389,
      "versionNonce": 1417069413,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787693848119,
      "link": null,
      "locked": false,
      "text": "+---------------------------+----------------------------------------------------------------------------------+\n| Provider                  | Notes                                                                            |\n+---------------------------+----------------------------------------------------------------------------------+\n| Vonage (Nexmo) Voice API  | Closest 1:1 Twilio competitor; has WebSocket media streaming too                 |\n+---------------------------+----------------------------------------------------------------------------------+\n| Telnyx                    | Cheaper per-minute, own network (fewer carrier hops = lower latency), also has a |\n|                            | WebSocket streaming API — popular for voice-AI bridges like yours               |\n+---------------------------+----------------------------------------------------------------------------------+\n| Plivo                     | Cheaper than Twilio, similar TwiML-like XML (\"PML\"), smaller ecosystem           |\n+---------------------------+----------------------------------------------------------------------------------+\n| Bandwidth                 | Owns its own carrier network (not reselling), good call quality/latency, used a  |\n|                            | lot for high-volume voice AI                                                    |\n+---------------------------+----------------------------------------------------------------------------------+\n| SignalWire                | Started as a Twilio-API-compatible drop-in (same TwiML dialect), often cited as  |\n|                            | cheapest swap-in migration                                                      |\n+---------------------------+----------------------------------------------------------------------------------+",
      "fontSize": 14.02152724616069,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+---------------------------+----------------------------------------------------------------------------------+\n| Provider                  | Notes                                                                            |\n+---------------------------+----------------------------------------------------------------------------------+\n| Vonage (Nexmo) Voice API  | Closest 1:1 Twilio competitor; has WebSocket media streaming too                 |\n+---------------------------+----------------------------------------------------------------------------------+\n| Telnyx                    | Cheaper per-minute, own network (fewer carrier hops = lower latency), also has a |\n|                            | WebSocket streaming API — popular for voice-AI bridges like yours               |\n+---------------------------+----------------------------------------------------------------------------------+\n| Plivo                     | Cheaper than Twilio, similar TwiML-like XML (\"PML\"), smaller ecosystem           |\n+---------------------------+----------------------------------------------------------------------------------+\n| Bandwidth                 | Owns its own carrier network (not reselling), good call quality/latency, used a  |\n|                            | lot for high-volume voice AI                                                    |\n+---------------------------+----------------------------------------------------------------------------------+\n| SignalWire                | Started as a Twilio-API-compatible drop-in (same TwiML dialect), often cited as  |\n|                            | cheapest swap-in migration                                                      |\n+---------------------------+----------------------------------------------------------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
