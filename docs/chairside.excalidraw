      "versionNonce": 180200400,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787066682800,
      "link": null,
      "locked": false,
      "text": "|                | /twilio/voice                  | /twilio/status                                             |\n| -------------- | ------------------------------ | ---------------------------------------------------------- |\n| Triggered by   | Call starts (or flow points)   | Any call-state change                                      |\n| Twilio expects | TwiML (controls the call)      | Just 200 ack                                               |\n| Purpose here   | Wires up the live media stream | Logging/observability of call outcomes                     |\n| Failure impact | Breaks the call                | Twilio just retries/gives up; doesn't affect the live call |\n",
      "fontSize": 26.349404472371997,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "|                | /twilio/voice                  | /twilio/status                                             |\n| -------------- | ------------------------------ | ---------------------------------------------------------- |\n| Triggered by   | Call starts (or flow points)   | Any call-state change                                      |\n| Twilio expects | TwiML (controls the call)      | Just 200 ack                                               |\n| Purpose here   | Wires up the live media stream | Logging/observability of call outcomes                     |\n| Failure impact | Breaks the call                | Twilio just retries/gives up; doesn't affect the live call |\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
