    {
      "id": "O6nXmn1xM6Cq7NDjyjxO7",
      "type": "text",
      "x": 28115.89957436274,
      "y": -7112.958672955486,
      "width": 676.0969366958838,
      "height": 61.46335788144396,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGy",
      "roundness": null,
      "seed": 481566925,
      "version": 1542,
      "versionNonce": 166923973,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787693848119,
      "link": null,
      "locked": false,
      "text": "A webhook is just an HTTP callback: instead of your app polling a third party for updates, \nyou give the third party a URL, and they POST to it when something happens on their end. \nA webhook application (or webhook handler/endpoint) is the part of your system built to receive and \nreact to those inbound calls.",
      "fontSize": 12.292671576288795,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A webhook is just an HTTP callback: instead of your app polling a third party for updates, \nyou give the third party a URL, and they POST to it when something happens on their end. \nA webhook application (or webhook handler/endpoint) is the part of your system built to receive and \nreact to those inbound calls.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
