    {
      "id": "_E6tZydaw4HQCQuxHWRQc",
      "type": "text",
      "x": 16572.80249183826,
      "y": -5310.238746026399,
      "width": 2574.001220703125,
      "height": 3285,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bE8",
      "roundness": null,
      "seed": 130430278,
      "version": 110,
      "versionNonce": 168319494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786555038331,
      "link": null,
      "locked": false,
      "text": " ┌───────────────────────────────────────────────────────┐\n │ (patient_id, doctor_id, date_str, start_time,              │\n │  duration_minutes, appointment_type, reason)               │\n └────────────────────────────┬──────────────────────────┘\n                                 ▼\n                   log \"attempting...\"\n                               │\n                               ▼\n                _parse_date(date_str) is None?\n                     ┌─────────┴─────────┐\n                    YES                  NO\n                     │                    │\n                     ▼                    ▼\n          return {booked:False,   start_dt = _parse_time(start_time)\n           \"Invalid date...\"}              │\n             [EXIT 1]              start_dt is None?\n                                 ┌─────────┴────────┐\n                                YES                  NO\n                                 │                    │\n                                 ▼                    ▼\n                      return {booked:False,   end_dt = start_dt + duration\n                       \"Invalid start          end_time = end_dt as \"HH:MM\"\n                        time...\"}              appt_id = \"A-\" + uuid\n                        [EXIT 2]                         │\n                                                         ▼\n                                          open DB connection + cursor\n                                                         │\n                                                         ▼\n                                       doctor = _fetch_doctor(cur, doctor_id)\n                                                          │\n                                              ┌──────────┴──────────┐\n                                          not doctor            doctor found\n                                              │                       │\n                                              ▼                       ▼\n                                   return {booked:False,   _patient_exists(cur, patient_id)?\n                                    \"No doctor found...\"}            │\n                                    [EXIT 3]              ┌─────────┴─────────┐\n                                                          NO                   YES\n                                                          │                     │\n                                                          ▼                     ▼\n                                            return {booked:False,   hours, block_reason =\n                                             \"No patient found...\"}   _get_working_window(...)\n                                             [EXIT 4]                          │\n                                                                    block_reason set?\n                                                               ┌──────────┴────────┐\n                                                              YES                    NO\n                                                               │                     │\n                                                               ▼                     ▼\n                                                 return {booked:False,   start within [hours.start,\n                                                  reason: block_reason}    hours.end] AND\n                                                  [EXIT 5]                 end within same?\n                                                                     ┌──────────┴──────────┐\n                                                                    NO                      YES\n                                                                     │                       │\n                                                                     ▼                       ▼\n                                                       return {booked:False,     ┌── try ──────────────┐\n                                                        \"Requested time falls    │ INSERT INTO          │\n                                                         outside...\"}            │  appointments (...)  │\n                                                         [EXIT 6]                │ conn.commit()        │\n                                                                                 └──────────┬──────────┘\n                                                                                             │\n                                                                     ┌─────────────────────┼──────────────────────┐\n                                                                     │                       │                        │\n                                                          ExclusionViolation          ForeignKeyViolation          no exception\n                                                                     │                       │                        │\n                                                                     ▼                       ▼                        ▼\n                                                       rollback()                 rollback()               log \"booked apptId=...\"\n                                                       reason = _exclusion_        return {booked:False,     return {booked:True,\n                                                        violation_reason(e)         \"Unknown patient           apptId, doctorId,\n                                                       return {booked:False,         or doctor ID.\"}           doctorName, date,\n                                                        reason}                      [EXIT 8]                  startTime, endTime}\n                                                       [EXIT 7]                                                [EXIT 9 — SUCCESS]\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " ┌───────────────────────────────────────────────────────┐\n │ (patient_id, doctor_id, date_str, start_time,              │\n │  duration_minutes, appointment_type, reason)               │\n └────────────────────────────┬──────────────────────────┘\n                                 ▼\n                   log \"attempting...\"\n                               │\n                               ▼\n                _parse_date(date_str) is None?\n                     ┌─────────┴─────────┐\n                    YES                  NO\n                     │                    │\n                     ▼                    ▼\n          return {booked:False,   start_dt = _parse_time(start_time)\n           \"Invalid date...\"}              │\n             [EXIT 1]              start_dt is None?\n                                 ┌─────────┴────────┐\n                                YES                  NO\n                                 │                    │\n                                 ▼                    ▼\n                      return {booked:False,   end_dt = start_dt + duration\n                       \"Invalid start          end_time = end_dt as \"HH:MM\"\n                        time...\"}              appt_id = \"A-\" + uuid\n                        [EXIT 2]                         │\n                                                         ▼\n                                          open DB connection + cursor\n                                                         │\n                                                         ▼\n                                       doctor = _fetch_doctor(cur, doctor_id)\n                                                          │\n                                              ┌──────────┴──────────┐\n                                          not doctor            doctor found\n                                              │                       │\n                                              ▼                       ▼\n                                   return {booked:False,   _patient_exists(cur, patient_id)?\n                                    \"No doctor found...\"}            │\n                                    [EXIT 3]              ┌─────────┴─────────┐\n                                                          NO                   YES\n                                                          │                     │\n                                                          ▼                     ▼\n                                            return {booked:False,   hours, block_reason =\n                                             \"No patient found...\"}   _get_working_window(...)\n                                             [EXIT 4]                          │\n                                                                    block_reason set?\n                                                               ┌──────────┴────────┐\n                                                              YES                    NO\n                                                               │                     │\n                                                               ▼                     ▼\n                                                 return {booked:False,   start within [hours.start,\n                                                  reason: block_reason}    hours.end] AND\n                                                  [EXIT 5]                 end within same?\n                                                                     ┌──────────┴──────────┐\n                                                                    NO                      YES\n                                                                     │                       │\n                                                                     ▼                       ▼\n                                                       return {booked:False,     ┌── try ──────────────┐\n                                                        \"Requested time falls    │ INSERT INTO          │\n                                                         outside...\"}            │  appointments (...)  │\n                                                         [EXIT 6]                │ conn.commit()        │\n                                                                                 └──────────┬──────────┘\n                                                                                             │\n                                                                     ┌─────────────────────┼──────────────────────┐\n                                                                     │                       │                        │\n                                                          ExclusionViolation          ForeignKeyViolation          no exception\n                                                                     │                       │                        │\n                                                                     ▼                       ▼                        ▼\n                                                       rollback()                 rollback()               log \"booked apptId=...\"\n                                                       reason = _exclusion_        return {booked:False,     return {booked:True,\n                                                        violation_reason(e)         \"Unknown patient           apptId, doctorId,\n                                                       return {booked:False,         or doctor ID.\"}           doctorName, date,\n                                                        reason}                      [EXIT 8]                  startTime, endTime}\n                                                       [EXIT 7]                                                [EXIT 9 — SUCCESS]\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "DJiO-36czdm1iig7pFCnN",
      "type": "text",
      "x": 19111.103018707712,
      "y": -2951.8859705266113,
      "width": 1088.999267578125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bE9",
