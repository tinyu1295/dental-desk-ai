    },
    {
      "id": "BGttPHs5Wl1pBv0StpzhU",
      "type": "text",
      "x": 8730.90749877848,
      "y": 774.4099485044288,
      "width": 593.9996337890625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b78",
      "roundness": null,
      "seed": 2007223998,
      "version": 365,
      "versionNonce": 1428074054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786468060840,
      "link": null,
      "locked": false,
      "text": "Patient 1 → not match\nPatient 2 → not match\nPatient 3 → not match\n...\nPatient 7,843,291 → MATCH!\n...\nPatient 10,000,000 → not match",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
