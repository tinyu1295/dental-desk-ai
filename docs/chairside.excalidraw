      "updated": 1786646046430,
      "link": null,
      "locked": false,
      "text": "┌──────────────────────────────────────┐\n│ HTTP POST                             │\n│                                      │\n│ URL: /twilio/voice                   │\n│                                      │\n│ Headers:                             │\n│   X-Twilio-Signature: abcXYZ123...   │\n│                                      │\n│ Body:                                │\n│   CallSid = CAtest1234567890         │\n│   From = +15551234567                │\n│   To = +15557654321                  │\n│   CallStatus = ringing               │\n└──────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌──────────────────────────────────────┐\n│ HTTP POST                             │\n│                                      │\n│ URL: /twilio/voice                   │\n│                                      │\n│ Headers:                             │\n│   X-Twilio-Signature: abcXYZ123...   │\n│                                      │\n│ Body:                                │\n│   CallSid = CAtest1234567890         │\n│   From = +15551234567                │\n│   To = +15557654321                  │\n│   CallStatus = ringing               │\n└──────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
