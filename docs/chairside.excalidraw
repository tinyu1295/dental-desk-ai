    {
      "id": "wfedWW0x5FkRnlvryGm9n",
      "type": "text",
      "x": 30396.412131904304,
      "y": -6211.441278252374,
      "width": 739.08203125,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEZ",
      "roundness": null,
      "seed": 516098612,
      "version": 22,
      "versionNonce": 81924276,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786645325419,
      "link": null,
      "locked": false,
      "text": "caller dials the number\n         │\n         ▼\n┌─────────────────────┐\n│ Twilio infrastructure│  ← the actual phone call lands here first,\n└─────────────────────┘    not at our API\n         │\n         │  HTTP POST /twilio/voice\n         │  (CallSid, From, To, X-Twilio-Signature header)\n         ▼\n┌─────────────────────┐\n│  our API             │\n│  [validation here]  │  ← checks X-Twilio-Signature on this\n└─────────────────────┘    incoming request\n         │\n         │  HTTP response: TwiML (the XML)\n         ▼\n┌─────────────────────┐\n│ Twilio infrastructure│  ← acts on the TwiML (speaks the <Say>,\n└─────────────────────┘    later opens the media stream)\n         │\n         ▼\n      caller hears it\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "caller dials the number\n         │\n         ▼\n┌─────────────────────┐\n│ Twilio infrastructure│  ← the actual phone call lands here first,\n└─────────────────────┘    not at our API\n         │\n         │  HTTP POST /twilio/voice\n         │  (CallSid, From, To, X-Twilio-Signature header)\n         ▼\n┌─────────────────────┐\n│  our API             │\n│  [validation here]  │  ← checks X-Twilio-Signature on this\n└─────────────────────┘    incoming request\n         │\n         │  HTTP response: TwiML (the XML)\n         ▼\n┌─────────────────────┐\n│ Twilio infrastructure│  ← acts on the TwiML (speaks the <Say>,\n└─────────────────────┘    later opens the media stream)\n         │\n         ▼\n      caller hears it\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
