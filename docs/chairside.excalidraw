      "link": null,
      "locked": false,
      "text": "from datetime import datetime, timedelta\n\nnow = datetime.now()\ntomorrow = now + timedelta(days=1)\nin_30_min = now + timedelta(minutes=30)\nappointment_window = timedelta(hours=1)\n\n# also useful for comparisons\nif (now - some_past_time) > timedelta(days=7):\n    ...",
