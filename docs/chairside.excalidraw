    {
      "id": "-VyV3hoeLUPIloqBrtUpb",
      "type": "text",
      "x": 12651.796204054071,
      "y": -5098.006880709396,
      "width": 1861.199951171875,
      "height": 7155,
      "angle": 0,
      "strokeColor": "#1e1e1e",
