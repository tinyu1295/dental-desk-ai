    {
      "id": "U7XTv2msxtACDlcZ5W8xD",
      "type": "text",
      "x": 27903.30417029043,
      "y": -7730.164318808932,
      "width": 734.25,
      "height": 75.02817206400961,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
