      "versionNonce": 457671954,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786987686915,
      "link": null,
      "locked": false,
      "text": "/twilio/voice   (HTTP, fires once)     → returns TwiML pointing at... (gonna return instructions, not audio)\n/twilio/status  (HTTP, fires repeatedly) → call state events only, never audio\n\n/media-stream   (WebSocket, fires once, sustained for the whole call) → the actual audio, not built yet",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/twilio/voice   (HTTP, fires once)     → returns TwiML pointing at... (gonna return instructions, not audio)\n/twilio/status  (HTTP, fires repeatedly) → call state events only, never audio\n\n/media-stream   (WebSocket, fires once, sustained for the whole call) → the actual audio, not built yet",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
