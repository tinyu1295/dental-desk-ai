    {
      "id": "aBUF075JW1Y33C86y8ikl",
      "type": "text",
      "x": 27216.54558183225,
      "y": -8154.225979043022,
      "width": 1015.123046875,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF9",
      "roundness": null,
      "seed": 1986058160,
      "version": 210,
      "versionNonce": 258138987,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787693833134,
      "link": null,
      "locked": false,
      "text": "dental-desk-ai/\n├── docker-compose.yml          # infrastructure: Postgres + booking_service + voice_gateway\n├── Makefile                    # manual smoke tests + health checks against the running API\n├── .env                        # local secrets/config, git-ignored\n├── .env.example                # template for .env\n└── services/\n    ├── booking_service/        # microservice\n    │   ├── Dockerfile\n    │   ├── requirements.txt\n    │   ├── TESTING.md          # manual smoke test docs (run via the root Makefile)\n    │   ├── TOOL_REFERENCE.md   # tool API reference for the booking service\n    │   └── app/\n    │       ├── main.py\n    │       └── db.py           # database connection/session setup\n    └── voice_gateway/          # microservice\n        ├── Dockerfile\n        ├── requirements.txt\n        ├── TESTING.md          # manual smoke test docs (run via the root Makefile)\n        ├── test_signature.py   # local Twilio signature computation for manual curl tests\n        └── app/\n            └── main.py\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dental-desk-ai/\n├── docker-compose.yml          # infrastructure: Postgres + booking_service + voice_gateway\n├── Makefile                    # manual smoke tests + health checks against the running API\n├── .env                        # local secrets/config, git-ignored\n├── .env.example                # template for .env\n└── services/\n    ├── booking_service/        # microservice\n    │   ├── Dockerfile\n    │   ├── requirements.txt\n    │   ├── TESTING.md          # manual smoke test docs (run via the root Makefile)\n    │   ├── TOOL_REFERENCE.md   # tool API reference for the booking service\n    │   └── app/\n    │       ├── main.py\n    │       └── db.py           # database connection/session setup\n    └── voice_gateway/          # microservice\n        ├── Dockerfile\n        ├── requirements.txt\n        ├── TESTING.md          # manual smoke test docs (run via the root Makefile)\n        ├── test_signature.py   # local Twilio signature computation for manual curl tests\n        └── app/\n            └── main.py\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
