      "isDeleted": false,
      "boundElements": [
        {
          "id": "eqh5Yk1QE69m0izRX5Kvx",
          "type": "arrow"
        }
      ],
      "updated": 1787252336181,
      "link": null,
      "locked": false,
      "text": "                  TEST PROGRAM\n                       │\n                       │\n              Generate 440 Hz tone\n                       │\n                       ▼\n                 8000 PCM16\n                   samples\n                       │\n                       │ PCM16 → μ-law\n                       ▼\n                8000 μ-law\n                   samples\n                       │\n                       │\n             Split into 20ms frames\n                       │\n                       ▼\n              ┌────────────────┐\n              │ 160 samples      │ frame 1\n              ├────────────────┤\n              │ 160 samples      │ frame 2\n              ├────────────────┤\n              │ 160 samples      │ frame 3\n              ├────────────────┤\n              │      ...         │\n              ├────────────────┤\n              │ 160 samples      │ frame 50\n              └────────────────┘\n                       │\n                       │ Base64 + JSON\n                       ▼\n                WebSocket\n                       │\n                       ▼\n             ┌──────────────────┐\n             │ voice_gateway      │\n             │ localhost:8001     │\n             └──────────────────┘\n                       │\n                       │ echoes audio\n                       ▼\n                WebSocket\n                       │\n                       ▼\n              Base64 → bytes\n                       │\n                       ▼\n                  μ-law\n                       │\n                       │ μ-law → PCM16\n                       ▼\n                echoed_pcm16\n                       │\n                       ▼\n                echo_test.wav",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                  TEST PROGRAM\n                       │\n                       │\n              Generate 440 Hz tone\n                       │\n                       ▼\n                 8000 PCM16\n                   samples\n                       │\n                       │ PCM16 → μ-law\n                       ▼\n                8000 μ-law\n                   samples\n                       │\n                       │\n             Split into 20ms frames\n                       │\n                       ▼\n              ┌────────────────┐\n              │ 160 samples      │ frame 1\n              ├────────────────┤\n              │ 160 samples      │ frame 2\n              ├────────────────┤\n              │ 160 samples      │ frame 3\n              ├────────────────┤\n              │      ...         │\n              ├────────────────┤\n              │ 160 samples      │ frame 50\n              └────────────────┘\n                       │\n                       │ Base64 + JSON\n                       ▼\n                WebSocket\n                       │\n                       ▼\n             ┌──────────────────┐\n             │ voice_gateway      │\n             │ localhost:8001     │\n             └──────────────────┘\n                       │\n                       │ echoes audio\n                       ▼\n                WebSocket\n                       │\n                       ▼\n              Base64 → bytes\n                       │\n                       ▼\n                  μ-law\n                       │\n                       │ μ-law → PCM16\n                       ▼\n                echoed_pcm16\n                       │\n                       ▼\n                echo_test.wav",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
