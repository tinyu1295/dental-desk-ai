    {
      "id": "qJOp4Le5wZ1P_J5QF0x63",
      "type": "text",
      "x": 33864.891293428416,
      "y": -4366.1051578282695,
      "width": 1056,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTJ",
      "roundness": null,
      "seed": 2027137207,
      "version": 171,
      "versionNonce": 582149049,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787847981895,
      "link": null,
      "locked": false,
      "text": "+-------------+--------------------------------------------------------------------------------+\n| Verb        | Does                                                                           |\n+-------------+--------------------------------------------------------------------------------+\n| <Say>       | Text-to-speech — what you're using now                                         |\n+-------------+--------------------------------------------------------------------------------+\n| <Play>      | Plays an audio file                                                            |\n+-------------+--------------------------------------------------------------------------------+\n| <Gather>    | Collects caller input — DTMF keypresses or speech — then POSTs it to another   |\n|             | webhook                                                                        |\n+-------------+--------------------------------------------------------------------------------+\n| <Record>    | Records the call                                                               |\n+-------------+--------------------------------------------------------------------------------+\n| <Dial>      | Connects the call to another number                                            |\n+-------------+--------------------------------------------------------------------------------+\n| <Hangup>    | Ends the call                                                                  |\n+-------------+--------------------------------------------------------------------------------+\n| <Redirect>  | Hands control to a different webhook URL mid-call                              |\n+-------------+--------------------------------------------------------------------------------+",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+-------------+--------------------------------------------------------------------------------+\n| Verb        | Does                                                                           |\n+-------------+--------------------------------------------------------------------------------+\n| <Say>       | Text-to-speech — what you're using now                                         |\n+-------------+--------------------------------------------------------------------------------+\n| <Play>      | Plays an audio file                                                            |\n+-------------+--------------------------------------------------------------------------------+\n| <Gather>    | Collects caller input — DTMF keypresses or speech — then POSTs it to another   |\n|             | webhook                                                                        |\n+-------------+--------------------------------------------------------------------------------+\n| <Record>    | Records the call                                                               |\n+-------------+--------------------------------------------------------------------------------+\n| <Dial>      | Connects the call to another number                                            |\n+-------------+--------------------------------------------------------------------------------+\n| <Hangup>    | Ends the call                                                                  |\n+-------------+--------------------------------------------------------------------------------+\n| <Redirect>  | Hands control to a different webhook URL mid-call                              |\n+-------------+--------------------------------------------------------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
