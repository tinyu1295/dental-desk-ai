      "version": 388,
      "versionNonce": 2032119692,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "O000e0vnyh_7xjEcI9XBM",
          "type": "arrow"
        }
      ],
      "updated": 1786645852316,
      "link": null,
      "locked": false,
      "text": "hmac.new(b\"myfakeauthtoken1234\", data.encode(), hashlib.sha1)\n            │                       │                │\n            │                       │                └── digestmod\n            │                       └── msg\n            └── key\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
