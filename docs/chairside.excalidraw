      "isDeleted": true,
      "boundElements": [],
      "updated": 1786808765155,
      "link": null,
      "locked": false,
      "text": " INPUTS\n ┌───────────────┬─────────────────────────┬─────────────────────┐\n │ auth_token     │ url                     │ params (dict)            │\n │ \"abc123...\"    │ \"http://.../voice\"      │ {CallSid, From, To,      │\n │                │                         │  CallStatus}             │\n └──────┬───────┴───────────┬────────────┴─────────────┬─────────┘\n         │                    │                             │\n         │                    ▼                             ▼\n         │        data = url (start string)     sort params by KEY\n         │                     │                           │\n         │                     │        for each (key, value) in sorted order:\n         │                     │◄────────  data += key + value   (no separators!)\n         │                     │\n         │                     ▼\n         │        data = \"http://localhost:8001/twilio/voice\"\n         │               + \"CallSid\" + \"CAtest1234567890\"\n         │               + \"CallStatus\" + \"ringing\"\n         │               + \"From\" + \"+15551234567\"\n         │               + \"To\" + \"+15557654321\"\n         │\n         ▼\n ┌──────────────────────────────────────────────────────┐\n │ digest = HMAC-SHA1(key=auth_token, message=data)          │\n └───────────────────────────┬──────────────────────────┘\n                                ▼\n ┌──────────────────────────────────────────────────────┐\n │ signature = base64_encode(digest)                         │\n └───────────────────────────┬──────────────────────────┘\n                                ▼\n                    return signature (str)\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " INPUTS\n ┌───────────────┬─────────────────────────┬─────────────────────┐\n │ auth_token     │ url                     │ params (dict)            │\n │ \"abc123...\"    │ \"http://.../voice\"      │ {CallSid, From, To,      │\n │                │                         │  CallStatus}             │\n └──────┬───────┴───────────┬────────────┴─────────────┬─────────┘\n         │                    │                             │\n         │                    ▼                             ▼\n         │        data = url (start string)     sort params by KEY\n         │                     │                           │\n         │                     │        for each (key, value) in sorted order:\n         │                     │◄────────  data += key + value   (no separators!)\n         │                     │\n         │                     ▼\n         │        data = \"http://localhost:8001/twilio/voice\"\n         │               + \"CallSid\" + \"CAtest1234567890\"\n         │               + \"CallStatus\" + \"ringing\"\n         │               + \"From\" + \"+15551234567\"\n         │               + \"To\" + \"+15557654321\"\n         │\n         ▼\n ┌──────────────────────────────────────────────────────┐\n │ digest = HMAC-SHA1(key=auth_token, message=data)          │\n └───────────────────────────┬──────────────────────────┘\n                                ▼\n ┌──────────────────────────────────────────────────────┐\n │ signature = base64_encode(digest)                         │\n └───────────────────────────┬──────────────────────────┘\n                                ▼\n                    return signature (str)\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "hU--eCBotiG0y1HKVlyyM",
      "type": "text",
