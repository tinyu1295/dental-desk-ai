      "isDeleted": true,
      "boundElements": [],
      "updated": 1786289206804,
      "link": null,
      "locked": false,
      "text": "except errors.UniqueViolation:\n    conn.rollback()\n    return {\"registered\": False, \"reason\": \"A patient with this name and date of birth already exists.\"}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "except errors.UniqueViolation:\n    conn.rollback()\n    return {\"registered\": False, \"reason\": \"A patient with this name and date of birth already exists.\"}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "wK-UvFDPLaVkkw28Aec_B",
      "type": "text",
      "x": 7450.657879799155,
      "y": -620.0639868794415,
      "width": 2789.06298828125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b75",
      "roundness": null,
      "seed": 1216918626,
      "version": 8,
      "versionNonce": 1672442210,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786288867552,
      "link": null,
      "locked": false,
      "text": "So the index isn't queried directly in Python — it's what turns \"duplicate patient\" from a silent bad row into a catchable exception with a clean API response.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So the index isn't queried directly in Python — it's what turns \"duplicate patient\" from a silent bad row into a catchable exception with a clean API response.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
