      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bD4",
      "roundness": null,
      "seed": 94865027,
      "version": 66,
      "versionNonce": 1599466189,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786447041193,
      "link": null,
      "locked": false,
      "text": "_find_next_opening(date_from, date_to, duration_minutes, doctor_id)\n│\n├─ log \"searching...\"\n│\n├─ start_day = _parse_date(date_from)     ─┐\n├─ end_day   = _parse_date(date_to)        │  each: strptime \"%Y-%m-%d\",\n│                                           │  None on ValueError/TypeError\n│                                          ─┘\n├─ start_day/end_day is None?\n│   └─ YES → log \"invalid date\" → return {found:false, \"Invalid date...\"}  [EXIT 1]\n│\n├─ open DB connection + cursor\n│\n├─ doctor_id given?\n│   ├─ YES → doctor = _fetch_doctor(cur, doctor_id)   (SELECT doctors WHERE id=?)\n│   │         └─ not found → log → return {found:false,\"No doctor found...\"} [EXIT 2]\n│   │         └─ found → candidates = [doctor]\n│   └─ NO  → SELECT * FROM doctors ORDER BY doctor_id\n│             └─ empty → log → return {found:false,\"No doctors on file.\"}   [EXIT 3]\n│             └─ candidates = all doctors\n│\n├─ step = timedelta(duration_minutes)\n├─ day = start_day\n│\n├─ ┌─────────── while day <= end_day ───────────┐\n│  │ date_str = day as \"YYYY-MM-DD\"              │\n│  │ best = None                                 │\n│  │                                             │\n│  │ ┌──── for doc in candidates ────┐           │\n│  │ │ hours, reason =                │           │\n│  │ │   _get_working_window(         │           │\n│  │ │     cur, doc.id, date_str)     │           │\n│  │ │   ├─ day_of_week = DAY_CODES[weekday]      │\n│  │ │   ├─ SELECT working_hours WHERE            │\n│  │ │   │    doctor_id=? AND day_of_week=?       │\n│  │ │   │    none → return (None,\"doesn't work\") │\n│  │ │   ├─ SELECT 1 FROM time_off WHERE          │\n│  │ │   │    doctor_id=? AND date BETWEEN...     │\n│  │ │   │    hit  → return (None,\"off this day\") │\n│  │ │   └─ else → return (hours, None)           │\n│  │ │                                            │\n│  │ │ reason set? → continue (skip this doctor)  │\n│  │ │                                            │\n│  │ │ SELECT booked start/end FROM appointments  │\n│  │ │   WHERE doctor_id=? AND date=?             │\n│  │ │   AND status NOT IN (Cancelled,Rescheduled)│\n│  │ │                                            │\n│  │ │ slots = _compute_slots(day, hours,         │\n│  │ │            booked, step)                   │\n│  │ │   ├─ cursor = combine(day, start_time)     │\n│  │ │   ├─ end    = combine(day, end_time)       │\n│  │ │   └─ while cursor+step <= end:             │\n│  │ │        skip if overlaps any booked range   │\n│  │ │        else append {startTime,endTime}     │\n│  │ │        cursor += step                      │\n│  │ │                                            │\n│  │ │ slots non-empty AND earlier than            │\n│  │ │   current best?  → best = (slot, doc)       │\n│  │ └────────────────────────────────────────────┘\n│  │ (loop repeats for every candidate doctor)\n│  │\n│  │ best found today?\n│  │   └─ YES → log \"found\" → return              [EXIT 4 — SUCCESS]\n│  │            {found:true, date, startTime,\n│  │             endTime, doctorId, doctorName}\n│  │\n│  │ day += 1 day, loop continues\n│  └───────────────────────────────────────────────┘\n│\n└─ loop exhausted without a match\n   └─ log \"no opening found\" → return              [EXIT 5]\n      {found:false, \"No opening between X and Y.\"}\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "_find_next_opening(date_from, date_to, duration_minutes, doctor_id)\n│\n├─ log \"searching...\"\n│\n├─ start_day = _parse_date(date_from)     ─┐\n├─ end_day   = _parse_date(date_to)        │  each: strptime \"%Y-%m-%d\",\n│                                           │  None on ValueError/TypeError\n│                                          ─┘\n├─ start_day/end_day is None?\n│   └─ YES → log \"invalid date\" → return {found:false, \"Invalid date...\"}  [EXIT 1]\n│\n├─ open DB connection + cursor\n│\n├─ doctor_id given?\n│   ├─ YES → doctor = _fetch_doctor(cur, doctor_id)   (SELECT doctors WHERE id=?)\n│   │         └─ not found → log → return {found:false,\"No doctor found...\"} [EXIT 2]\n│   │         └─ found → candidates = [doctor]\n│   └─ NO  → SELECT * FROM doctors ORDER BY doctor_id\n│             └─ empty → log → return {found:false,\"No doctors on file.\"}   [EXIT 3]\n│             └─ candidates = all doctors\n│\n├─ step = timedelta(duration_minutes)\n├─ day = start_day\n│\n├─ ┌─────────── while day <= end_day ───────────┐\n│  │ date_str = day as \"YYYY-MM-DD\"              │\n│  │ best = None                                 │\n│  │                                             │\n│  │ ┌──── for doc in candidates ────┐           │\n│  │ │ hours, reason =                │           │\n│  │ │   _get_working_window(         │           │\n│  │ │     cur, doc.id, date_str)     │           │\n│  │ │   ├─ day_of_week = DAY_CODES[weekday]      │\n│  │ │   ├─ SELECT working_hours WHERE            │\n│  │ │   │    doctor_id=? AND day_of_week=?       │\n│  │ │   │    none → return (None,\"doesn't work\") │\n│  │ │   ├─ SELECT 1 FROM time_off WHERE          │\n│  │ │   │    doctor_id=? AND date BETWEEN...     │\n│  │ │   │    hit  → return (None,\"off this day\") │\n│  │ │   └─ else → return (hours, None)           │\n│  │ │                                            │\n│  │ │ reason set? → continue (skip this doctor)  │\n│  │ │                                            │\n│  │ │ SELECT booked start/end FROM appointments  │\n│  │ │   WHERE doctor_id=? AND date=?             │\n│  │ │   AND status NOT IN (Cancelled,Rescheduled)│\n│  │ │                                            │\n│  │ │ slots = _compute_slots(day, hours,         │\n│  │ │            booked, step)                   │\n│  │ │   ├─ cursor = combine(day, start_time)     │\n│  │ │   ├─ end    = combine(day, end_time)       │\n│  │ │   └─ while cursor+step <= end:             │\n│  │ │        skip if overlaps any booked range   │\n│  │ │        else append {startTime,endTime}     │\n│  │ │        cursor += step                      │\n│  │ │                                            │\n│  │ │ slots non-empty AND earlier than            │\n│  │ │   current best?  → best = (slot, doc)       │\n│  │ └────────────────────────────────────────────┘\n│  │ (loop repeats for every candidate doctor)\n│  │\n│  │ best found today?\n│  │   └─ YES → log \"found\" → return              [EXIT 4 — SUCCESS]\n│  │            {found:true, date, startTime,\n│  │             endTime, doctorId, doctorName}\n│  │\n│  │ day += 1 day, loop continues\n│  └───────────────────────────────────────────────┘\n│\n└─ loop exhausted without a match\n   └─ log \"no opening found\" → return              [EXIT 5]\n      {found:false, \"No opening between X and Y.\"}\n",
