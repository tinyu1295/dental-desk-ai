      "seed": 1437880346,
      "version": 258,
      "versionNonce": 938604486,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786469216873,
      "link": null,
      "locked": false,
      "text": "ForeignKeyViolation check\n\nTOCTOU (time-of-check-to-time-of-use) guard: \na race where the patient/doctor row gets deleted \nby some other concurrent request \nin the gap between this function's existence check and \nits INSERT actually committing. ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ForeignKeyViolation check\n\nTOCTOU (time-of-check-to-time-of-use) guard: \na race where the patient/doctor row gets deleted \nby some other concurrent request \nin the gap between this function's existence check and \nits INSERT actually committing. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "EY1lR1vgRAq7Iq5i5eHBF",
      "type": "text",
      "x": 17022.850471065893,
      "y": -1934.3300734184418,
      "width": 1516.0423583984375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEA",
      "roundness": null,
      "seed": 1165555462,
      "version": 200,
      "versionNonce": 1605046022,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786469216873,
      "link": null,
      "locked": false,
      "text": "existing:  09:00 ────── 09:30\nnew #1:    09:00 ────── 09:30   <- exact same → violation\nnew #2:       09:15 ────── 09:45  <- partial overlap → violation\nnew #3:                09:30 ────── 10:00   <- touches, doesn't overlap → OK\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "existing:  09:00 ────── 09:30\nnew #1:    09:00 ────── 09:30   <- exact same → violation\nnew #2:       09:15 ────── 09:45  <- partial overlap → violation\nnew #3:                09:30 ────── 10:00   <- touches, doesn't overlap → OK\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
