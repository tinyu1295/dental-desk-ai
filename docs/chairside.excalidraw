      "updated": 1787069695675,
      "link": null,
      "locked": false,
      "text": "What is μ-law (mu-law)?",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is μ-law (mu-law)?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "KRNQOG2c4q_iYY7iRTR3v",
      "type": "text",
      "x": 30046.711023858905,
      "y": -2431.0636797567904,
      "width": 893.1997680664062,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOB",
      "roundness": null,
      "seed": 272966289,
      "version": 43,
      "versionNonce": 566586641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787069714410,
      "link": null,
      "locked": false,
      "text": "Phone systems have a problem. \nSending full PCM audio over the phone uses more bandwidth.\nSo they compress it using μ-law.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Phone systems have a problem. \nSending full PCM audio over the phone uses more bandwidth.\nSo they compress it using μ-law.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
