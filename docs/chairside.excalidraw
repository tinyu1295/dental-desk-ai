    {
      "id": "JD4ZNu4hAa9iyQ5tttiMJ",
      "type": "text",
      "x": 9202.549794433084,
      "y": -2956.81313122216,
      "width": 1108.79931640625,
      "height": 1800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDx",
      "roundness": null,
      "seed": 351545997,
      "version": 193,
      "versionNonce": 261652163,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786449455604,
      "link": null,
      "locked": false,
      "text": " ┌──────────────────────────────────────────────┐\n │ (day, hours, booked, step)                        │\n └───────────────────┬──────────────────────────┘\n                      ▼\n     cursor = datetime.combine(day, hours[\"start_time\"])\n     end    = datetime.combine(day, hours[\"end_time\"])\n     slots  = []\n                      │\n                      ▼\n        ┌──── while cursor + step <= end ────┐\n        │                                     │\n        │   slot_start = cursor.time()        │\n        │   slot_end   = (cursor+step).time() │\n        │                                     │\n        │   overlaps = any(                   │\n        │     slot_start < b_end AND          │\n        │     slot_end   > b_start            │\n        │     for (b_start,b_end) in booked)  │\n        │                                     │\n        │        ┌────────┴────────┐        │\n        │        │                 │          │\n        │    overlaps          not overlaps   │\n        │        │                 │          │\n        │        ▼                 ▼          │\n        │   (skip --         slots.append(    │\n        │    do nothing)      {\"startTime\":   │\n        │        │             slot_start,    │\n        │        │             \"endTime\":     │\n        │        │             slot_end})     │\n        │        │                 │          │\n        │        └────────┬────────┘         │\n        │                 ▼                    │\n        │        cursor += step                │\n        │                   │                  │\n        └─────────────────┴─────────────────┘\n                      │\n           (loop exits once cursor + step > end)\n                      ▼\n              return slots\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " ┌──────────────────────────────────────────────┐\n │ (day, hours, booked, step)                        │\n └───────────────────┬──────────────────────────┘\n                      ▼\n     cursor = datetime.combine(day, hours[\"start_time\"])\n     end    = datetime.combine(day, hours[\"end_time\"])\n     slots  = []\n                      │\n                      ▼\n        ┌──── while cursor + step <= end ────┐\n        │                                     │\n        │   slot_start = cursor.time()        │\n        │   slot_end   = (cursor+step).time() │\n        │                                     │\n        │   overlaps = any(                   │\n        │     slot_start < b_end AND          │\n        │     slot_end   > b_start            │\n        │     for (b_start,b_end) in booked)  │\n        │                                     │\n        │        ┌────────┴────────┐        │\n        │        │                 │          │\n        │    overlaps          not overlaps   │\n        │        │                 │          │\n        │        ▼                 ▼          │\n        │   (skip --         slots.append(    │\n        │    do nothing)      {\"startTime\":   │\n        │        │             slot_start,    │\n        │        │             \"endTime\":     │\n        │        │             slot_end})     │\n        │        │                 │          │\n        │        └────────┬────────┘         │\n        │                 ▼                    │\n        │        cursor += step                │\n        │                   │                  │\n        └─────────────────┴─────────────────┘\n                      │\n           (loop exits once cursor + step > end)\n                      ▼\n              return slots\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "oQXlM5XC3jZmwjXL8cuus",
      "type": "text",
      "x": 10601.28019430525,
      "y": -2823.142460784858,
      "width": 1501.199951171875,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDy",
      "roundness": null,
      "seed": 948599587,
      "version": 129,
      "versionNonce": 1607636205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786447557607,
      "link": null,
      "locked": false,
      "text": "Walking the loop (cursor from 09:00 up to 11:30, stepping by 30 min):\n\n+--------+-----------+----------+-----------------------------+-----------+\n| cursor | slot_start| slot_end | overlaps booked 10:00-10:30?| appended? |\n+--------+-----------+----------+-----------------------------+-----------+\n| 09:00  | 09:00     | 09:30    | no                          | ✅        |\n| 09:30  | 09:30     | 10:00    | no                          | ✅        |\n| 10:00  | 10:00     | 10:30    | yes                         | ❌ skipped |\n| 10:30  | 10:30     | 11:00    | no                          | ✅        |\n| 11:00  | 11:00     | 11:30    | no                          | ✅        |\n| 11:30  | 11:30     | 12:00    | no                          | ✅        |\n+--------+-----------+----------+-----------------------------+-----------+",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Walking the loop (cursor from 09:00 up to 11:30, stepping by 30 min):\n\n+--------+-----------+----------+-----------------------------+-----------+\n| cursor | slot_start| slot_end | overlaps booked 10:00-10:30?| appended? |\n+--------+-----------+----------+-----------------------------+-----------+\n| 09:00  | 09:00     | 09:30    | no                          | ✅        |\n| 09:30  | 09:30     | 10:00    | no                          | ✅        |\n| 10:00  | 10:00     | 10:30    | yes                         | ❌ skipped |\n| 10:30  | 10:30     | 11:00    | no                          | ✅        |\n| 11:00  | 11:00     | 11:30    | no                          | ✅        |\n| 11:30  | 11:30     | 12:00    | no                          | ✅        |\n+--------+-----------+----------+-----------------------------+-----------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "t0xqGwfNgeXkCdeT-mBO9",
      "type": "text",
      "x": 11114.079632354229,
      "y": -2169.0644087171513,
      "width": 930.5994262695312,
      "height": 360,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDz",
      "roundness": null,
      "seed": 1404549571,
      "version": 219,
      "versionNonce": 1416576003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786451979791,
      "link": null,
      "locked": false,
      "text": "[\n    {\"startTime\": \"09:00\", \"endTime\": \"09:30\"},\n    {\"startTime\": \"09:30\", \"endTime\": \"10:00\"},\n    {\"startTime\": \"10:30\", \"endTime\": \"11:00\"},\n    {\"startTime\": \"11:00\", \"endTime\": \"11:30\"},\n    {\"startTime\": \"11:30\", \"endTime\": \"12:00\"},\n]\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[\n    {\"startTime\": \"09:00\", \"endTime\": \"09:30\"},\n    {\"startTime\": \"09:30\", \"endTime\": \"10:00\"},\n    {\"startTime\": \"10:30\", \"endTime\": \"11:00\"},\n    {\"startTime\": \"11:00\", \"endTime\": \"11:30\"},\n    {\"startTime\": \"11:30\", \"endTime\": \"12:00\"},\n]\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
