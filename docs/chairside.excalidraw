      "seed": 1058335217,
      "version": 4,
      "versionNonce": 531600209,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786360102562,
      "link": null,
      "locked": false,
      "text": "for the same patient_id, no two occupying rows may have time_ranges that overlap (&&). It says nothing about which doctor — it only fires when the times collide.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for the same patient_id, no two occupying rows may have time_ranges that overlap (&&). It says nothing about which doctor — it only fires when the times collide.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "wf5QGHyyk14hjL_aqLLSA",
      "type": "text",
      "x": 2117.1412702161315,
      "y": 1935.2935518593144,
      "width": 2372.400634765625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCE",
      "roundness": null,
      "seed": 1039390641,
      "version": 406,
      "versionNonce": 1914250522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786469246272,
      "link": null,
      "locked": false,
      "text": "| Scenario                                                                  | Allowed?                                |\n| ------------------------------------------------------------------------- | --------------------------------------- |\n| Mon 9:00–9:30 with Dr. Cruz, Mon 10:00–10:30 with Dr. Lee                 | ✅ allowed — different times, no overlap |\n| Mon 9:00–9:30 with Dr. Cruz, Tue 9:00–9:30 with Dr. Lee                   | ✅ allowed — different days entirely     |\n| Mon 9:00–9:30 with Dr. Cruz, Mon 9:15–9:45 with Dr. Lee                   | ❌ rejected — 9:15–9:30 overlaps both    |\n| Mon 9:00–9:30 with Dr. Cruz, Mon 9:00–9:30 with Dr. Lee (exact same slot) | ❌ rejected — full overlap               |\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Scenario                                                                  | Allowed?                                |\n| ------------------------------------------------------------------------- | --------------------------------------- |\n| Mon 9:00–9:30 with Dr. Cruz, Mon 10:00–10:30 with Dr. Lee                 | ✅ allowed — different times, no overlap |\n| Mon 9:00–9:30 with Dr. Cruz, Tue 9:00–9:30 with Dr. Lee                   | ✅ allowed — different days entirely     |\n| Mon 9:00–9:30 with Dr. Cruz, Mon 9:15–9:45 with Dr. Lee                   | ❌ rejected — 9:15–9:30 overlaps both    |\n| Mon 9:00–9:30 with Dr. Cruz, Mon 9:00–9:30 with Dr. Lee (exact same slot) | ❌ rejected — full overlap               |\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
