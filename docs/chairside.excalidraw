      "link": null,
      "locked": false,
      "text": "What is the sample rate?",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is the sample rate?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "wH0JU2EoPTHDjrEZ-jCbf",
      "type": "text",
      "x": 28238.091293009835,
      "y": -3339.420638818622,
      "width": 791.99951171875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNJ",
      "roundness": null,
      "seed": 388787423,
      "version": 61,
      "versionNonce": 467854719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787068946150,
      "link": null,
      "locked": false,
      "text": "The sample rate is how many measurements are taken\nevery second.\n\nFor example:\n\n8,000 Hz = 8,000 measurements every second\n16,000 Hz = 16,000 measurements every second\n44,100 Hz = CD-quality music",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The sample rate is how many measurements are taken every second.\n\nFor example:\n\n8,000 Hz = 8,000 measurements every second\n16,000 Hz = 16,000 measurements every second\n44,100 Hz = CD-quality music",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
