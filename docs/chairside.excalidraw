      "isDeleted": false,
      "boundElements": [],
      "updated": 1787066579653,
      "link": null,
      "locked": false,
      "text": "| Event                  | When                                                   |\n| ---------------------- | ------------------------------------------------------ |\n| initiated              | Call leg created                                       |\n| ringing                | Callee's phone is ringing                              |\n| answered / in-progress | Call picked up                                         |\n| completed              | Call ended (hangup, no-answer, busy, failed, canceled) |\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Event                  | When                                                   |\n| ---------------------- | ------------------------------------------------------ |\n| initiated              | Call leg created                                       |\n| ringing                | Callee's phone is ringing                              |\n| answered / in-progress | Call picked up                                         |\n| completed              | Call ended (hangup, no-answer, busy, failed, canceled) |\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "5xAQS_4_rc61IrP45CD-t",
      "type": "text",
      "x": 30041.539729960376,
      "y": -6752.524881107629,
      "width": 1623.1243953164133,
      "height": 230.55728913325493,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
