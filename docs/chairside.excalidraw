      "link": null,
      "locked": false,
      "text": "Level 1                                 kim,s\n                                     /         \\\nLevel 2                        dean,r            patel,r\n                            /         \\         /         \\\nLevel 3               adams,e     jones,i     moore,d     smith,a",
      "fontSize": 36,
      "fontFamily": 8,
