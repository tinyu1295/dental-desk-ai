    {
      "id": "CE4_eIZL2LcR_ik_L-Qix",
      "type": "text",
      "x": 5202.412513345214,
      "y": 4519.430324499931,
      "width": 3187.798828125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
