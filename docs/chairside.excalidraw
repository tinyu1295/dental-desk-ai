    {
      "id": "UrqAhdTy3zjV77QBItKql",
      "type": "text",
      "x": 30603.410076483895,
      "y": 592.259047212904,
      "width": 871.199462890625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
