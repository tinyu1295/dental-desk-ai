      "seed": 552478807,
      "version": 360,
      "versionNonce": 1926798598,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788813800177,
      "link": null,
      "locked": false,
      "text": "Twilio is a cloud communications platform (CPaaS)\nit doesn't build the AI or the app logic, \nit gives you programmable APIs to send/receive phone calls, SMS, WhatsApp messages, etc. \nover regular telephone networks (PSTN).",
      "fontSize": 15.005634412801921,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twilio is a cloud communications platform (CPaaS)\nit doesn't build the AI or the app logic, \nit gives you programmable APIs to send/receive phone calls, SMS, WhatsApp messages, etc. \nover regular telephone networks (PSTN).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
