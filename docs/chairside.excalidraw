      "text": "start session → declare the prompt + its tools → open a text slot → fill it with the system prompt → close the slot?\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "start session → declare the prompt + its tools → open a text slot → fill it with the system prompt → close the slot?\n",
      "autoResize": true,
