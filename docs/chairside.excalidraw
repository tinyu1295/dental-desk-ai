      "updated": 1786360108673,
      "link": null,
      "locked": false,
      "text": "For any two rows, reject the new one if doctor_id is equal (=) AND time_range overlaps (&&).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For any two rows, reject the new one if doctor_id is equal (=) AND time_range overlaps (&&).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
