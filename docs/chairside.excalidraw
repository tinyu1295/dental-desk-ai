      "isDeleted": false,
      "boundElements": [],
      "updated": 1786447840437,
      "link": null,
      "locked": false,
      "text": "timedelta is a class from Python's datetime module that represents a duration — \na span of time, rather than a specific point in time (which is what datetime represents).\n\nYou typically use it to do date/time arithmetic:\n\n\n\n\n\n\n\n\n\n\n\n\n\nYou can construct it with days, seconds, microseconds, milliseconds, minutes, hours, weeks, any combination.\n\nstart_day/end_day are either both real datetime objects \n(safe to compare with <= and add timedelta to in the loop that follows)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "timedelta is a class from Python's datetime module that represents a duration — \na span of time, rather than a specific point in time (which is what datetime represents).\n\nYou typically use it to do date/time arithmetic:\n\n\n\n\n\n\n\n\n\n\n\n\n\nYou can construct it with days, seconds, microseconds, milliseconds, minutes, hours, weeks, any combination.\n\nstart_day/end_day are either both real datetime objects \n(safe to compare with <= and add timedelta to in the loop that follows)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
