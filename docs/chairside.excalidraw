      "boundElements": [],
      "updated": 1786446146144,
      "link": null,
      "locked": false,
      "text": "A — no working hours that day → (None, \"Doctor does not work this day\")\n\nB — works that day, but time off covers the date → (None, \"Doctor is off this day\"), \n    \nC — works that day, no time off → (hours_row, None), \n    ",
      "fontSize": 41.25897225256072,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A — no working hours that day → (None, \"Doctor does not work this day\")\n\nB — works that day, but time off covers the date → (None, \"Doctor is off this day\"), \n    \nC — works that day, no time off → (hours_row, None), \n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
