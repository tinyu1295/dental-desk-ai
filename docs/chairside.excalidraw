    {
      "id": "COxwozYrRXSzOBoAOeB1A",
      "type": "text",
      "x": 35903.50623142919,
      "y": -3234.2445248107265,
      "width": 1438.030517578125,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPl",
      "roundness": null,
      "seed": 1765416401,
      "version": 42,
      "versionNonce": 1390341311,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787088975618,
      "link": null,
      "locked": false,
      "text": " CALLER            TWILIO                    OUR SERVER              NOVA SONIC\n   │                  │                           │                      │\n   │══speaks══════════│══raw audio, live══════════│══raw audio, live════▶│\n   │  (continuous)     │  (μ-law over WebSocket)   │  (PCM16, forwarded)  │\n   │                  │                           │                      │ (STT + reasoning +\n   │                  │                           │                      │  TTS all happen\n   │                  │                           │                      │  inside one model,\n   │                  │                           │                      │  server-side turn\n   │                  │                           │                      │  detection)\n   │◀═hears reply═════│◀═raw audio, live══════════│◀═raw audio, live═════│\n   │  (live)           │                           │                      │\n   │                  │                           │                      │\n   │        one connection, held open for the entire call —\n   │        no webhook round trips, no discrete per-turn hops\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " CALLER            TWILIO                    OUR SERVER              NOVA SONIC\n   │                  │                           │                      │\n   │══speaks══════════│══raw audio, live══════════│══raw audio, live════▶│\n   │  (continuous)     │  (μ-law over WebSocket)   │  (PCM16, forwarded)  │\n   │                  │                           │                      │ (STT + reasoning +\n   │                  │                           │                      │  TTS all happen\n   │                  │                           │                      │  inside one model,\n   │                  │                           │                      │  server-side turn\n   │                  │                           │                      │  detection)\n   │◀═hears reply═════│◀═raw audio, live══════════│◀═raw audio, live═════│\n   │  (live)           │                           │                      │\n   │                  │                           │                      │\n   │        one connection, held open for the entire call —\n   │        no webhook round trips, no discrete per-turn hops\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
