    {
      "id": "6VWO1MICYVHoHLgdT1sCk",
      "type": "text",
      "x": 31886.423267972907,
      "y": -8109.894345707709,
      "width": 1847.0211181640625,
      "height": 1800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKd",
      "roundness": null,
      "seed": 355789744,
      "version": 19,
      "versionNonce": 820154800,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786805540104,
      "link": null,
      "locked": false,
      "text": " Guest's Phone          Twilio                      Your Service (main.py)\n      │                    │                                  │\n      │  dials hotel number│                                  │\n      ├───────────────────►│                                  │\n      │                    │                                  │\n      │                    │  POST /twilio/voice              │\n      │                    │  Content-Type: form-urlencoded    │\n      │                    │  X-Twilio-Signature: <hmac>       │\n      │                    │  body: CallSid=CAxxxx&From=+1...  │\n      │                    ├─────────────────────────────────►│\n      │                    │                                  │ 1. validate signature\n      │                    │                                  │    (_validate_twilio_request)\n      │                    │                                  │ 2. build TwiML response\n      │                    │  200 OK                          │\n      │                    │  <Response>                      │\n      │                    │    <Play>.../greeting.wav</Play> │\n      │                    │    <Connect>                     │\n      │                    │      <Stream url=\"wss://.../media-stream\"/>\n      │                    │    </Connect>                    │\n      │                    │  </Response>                     │\n      │                    │◄─────────────────────────────────┤\n      │                    │                                  │\n      │  plays greeting    │  GET /greeting.wav                │\n      │◄───────────────────┤─────────────────────────────────►│\n      │                    │                                  │\n      │                    │  WebSocket connect                │\n      │                    │  wss://.../media-stream           │\n      │                    ├═════════════════════════════════►│\n      │  live call audio   │  {\"event\":\"start\", streamSid:...} │\n      │◄══════════════════►│  {\"event\":\"media\", payload:...}   │  ← audio both directions,\n      │                    │◄═══════════════════════════════►│    not a webhook anymore\n      │                    │                                  │\n      │  call ends         │                                  │\n      ├───────────────────►│                                  │\n      │                    │  POST /twilio/status              │\n      │                    │  CallSid=CAxxxx&CallStatus=completed\n      │                    ├─────────────────────────────────►│\n      │                    │  200 OK                          │\n      │                    │◄─────────────────────────────────┤\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Guest's Phone          Twilio                      Your Service (main.py)\n      │                    │                                  │\n      │  dials hotel number│                                  │\n      ├───────────────────►│                                  │\n      │                    │                                  │\n      │                    │  POST /twilio/voice              │\n      │                    │  Content-Type: form-urlencoded    │\n      │                    │  X-Twilio-Signature: <hmac>       │\n      │                    │  body: CallSid=CAxxxx&From=+1...  │\n      │                    ├─────────────────────────────────►│\n      │                    │                                  │ 1. validate signature\n      │                    │                                  │    (_validate_twilio_request)\n      │                    │                                  │ 2. build TwiML response\n      │                    │  200 OK                          │\n      │                    │  <Response>                      │\n      │                    │    <Play>.../greeting.wav</Play> │\n      │                    │    <Connect>                     │\n      │                    │      <Stream url=\"wss://.../media-stream\"/>\n      │                    │    </Connect>                    │\n      │                    │  </Response>                     │\n      │                    │◄─────────────────────────────────┤\n      │                    │                                  │\n      │  plays greeting    │  GET /greeting.wav                │\n      │◄───────────────────┤─────────────────────────────────►│\n      │                    │                                  │\n      │                    │  WebSocket connect                │\n      │                    │  wss://.../media-stream           │\n      │                    ├═════════════════════════════════►│\n      │  live call audio   │  {\"event\":\"start\", streamSid:...} │\n      │◄══════════════════►│  {\"event\":\"media\", payload:...}   │  ← audio both directions,\n      │                    │◄═══════════════════════════════►│    not a webhook anymore\n      │                    │                                  │\n      │  call ends         │                                  │\n      ├───────────────────►│                                  │\n      │                    │  POST /twilio/status              │\n      │                    │  CallSid=CAxxxx&CallStatus=completed\n      │                    ├─────────────────────────────────►│\n      │                    │  200 OK                          │\n      │                    │◄─────────────────────────────────┤\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
